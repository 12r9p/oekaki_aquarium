{
  "name": "oekaki-aquarium",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:server":   "bun run --cwd packages/server dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "dev":          "bun run --filter '*' dev",
    "build":        "cd packages/frontend && bun run build",
    "typecheck":    "bun run --filter '*' typecheck"
  }
}
